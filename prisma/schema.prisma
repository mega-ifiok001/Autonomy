generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id           String   @id @default("main")
  eyebrow      String
  line1        String
  line2        String
  sub          String
  ctaPrimary   String
  ctaSecondary String
  cities       String
  img          String
  updatedAt    DateTime @updatedAt
}

model Contact {
  id        String   @id @default("main")
  email     String
  phone     String
  title     String
  sub       String
  button    String
  updatedAt DateTime @updatedAt
  offices   Office[]
}

model Office {
  id        String  @id @default(cuid())
  city      String
  line      String
  order     Int     @default(0)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model About {
  id         String      @id @default("main")
  eyebrow    String
  heading    String
  p1         String
  p2         String
  img        String
  statValue  String
  statText   String
  updatedAt  DateTime    @updatedAt
  principles Principle[]
}

model Principle {
  id      String @id @default(cuid())
  n       String
  title   String
  copy    String
  order   Int    @default(0)
  aboutId String
  about   About  @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Settings {
  id         String   @id @default("main")
  modelsNote String
  updatedAt  DateTime @updatedAt
}

model Service {
  id     String @id @default(cuid())
  icon   String
  title  String
  copy   String
  detail String
  order  Int    @default(0)
}

model Partner {
  id    String @id @default(cuid())
  name  String
  style Int    @default(0)
  order Int    @default(0)
}

model Stat {
  id       String @id @default(cuid())
  prefix   String
  value    Float
  suffix   String
  decimals Int
  label    String
  order    Int    @default(0)
}

model Step {
  id    String @id @default(cuid())
  title String
  copy  String
  order Int    @default(0)
}

model Audience {
  id    String @id @default(cuid())
  title String
  copy  String
  badge String
  order Int    @default(0)
}

model Engagement {
  key   String @id
  title String
  copy  String
}

model Insight {
  id        String   @id @default(cuid())
  title     String
  category  String
  date      String
  read      String
  img       String
  excerpt   String
  body      String
  featured  Boolean  @default(false)
  highlight Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  quote        String
  name         String
  role         String
  metricAValue String
  metricALabel String
  metricBValue String
  metricBLabel String
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  offering  String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model autonomy_contacts {
  id        String   @id
  type      String
  name      String
  email     String
  company   String   @default("")
  message   String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt], map: "autonomy_contacts_created_at_idx")
}

model autonomy_site_content {
  id        String   @id @default("website")
  data      Json
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
}
